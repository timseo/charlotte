{% if section.settings.background-color %}
    {% assign background_color = 'halo-section-background-gray' %}
{% endif %}

{% if section.settings.border-top %}
    {% assign border_top = 'halo-section-border-top' %}
{% endif %}

{% if section.settings.border-bottom %}
    {% assign border_bottom = 'halo-section-border-bottom' %}
{% endif %}

{% assign top = top | default: section.settings.top %}
{% assign bottom = bottom | default: section.settings.bottom %}

{% if section.settings.custom_color %}
<style>
    [data-section-id='{{ section.id }}'] .section-header .title {
        color: {{ section.settings.color_heading }};
    }

    [data-section-id='{{ section.id }}'] .section-header > p {
        color: {{ section.settings.color_text }};
    }

    [data-section-id='{{ section.id }}'] .section-header .btn {
        color: {{ section.settings.color_btn_text }};
        border-color: {{ section.settings.color_btn_text }};
    }

    [data-section-id='{{ section.id }}'] .section-header .btn:hover {
        filter: brightness(85%);
    }
</style>
{% endif %}

<div class="halo-section padding-top-{{ top }} padding-bottom-{{ bottom }} {{ background_color }} {{ border_top }} {{ border_bottom }}" data-section-id="{{ section.id }}" data-section-type="masonry_grid">
    <div class="container">
        {% if section.settings.title != blank %}
            <div class="section-header text-center">
              <h1 class="title title--large">{{ section.settings.title }}</h1>
              {% if section.settings.description != blank %}
                <p>{{ section.settings.description }}</p>
              {% endif %}
              {% if section.settings.button != blank %}
                <a href="{{ section.settings.button_link }}" class="btn btn--tertiary" aria-label="link">
                    {{ section.settings.button }}
                </a>
              {% endif %}
            </div>
        {% endif %}
        <div class="cc-container">
          {% for block in section.blocks %}
            <div class="cc-para cc-div vertical">
              <a href="{% if block.settings.link_url != blank %}{{ block.settings.link_url }}{% endif %}"> 
                
                {% assign img_url = block.settings.image | img_url: 'master' %}
                {% if block.settings.image != blank %}
                    <img alt="charlotte inspiration" src="{{ img_url }}"> 
                {% else %}
                    <span class="recommended_size">Free size</span>
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {% endif %}
              </a>
            </div>      
          {% endfor %}
        </div>
      
    </div>
</div>


{% schema %}
{
    "name": "Masonry grid",
    "settings": [
        {
            "type": "header",
            "content": "Section Layout"
        },
        {
            "type": "checkbox",
            "id": "background-color",
            "label": "Background Color Custom",
            "default": false
        },
        {
            "type": "checkbox",
            "id": "border-top",
            "label": "show border top",
            "default": false
        },
        {
            "type": "checkbox",
            "id": "border-bottom",
            "label": "show border bottom",
            "default": false
        },
        {
            "type": "range",
            "id": "top",
            "label": "Spacing Top",
            "default": 30,
            "min": 0,
            "max": 100,
            "step": 10,
            "unit": "px"
        },
        {
            "type": "range",
            "id": "bottom",
            "label": "Spacing bottom",
            "default": 30,
            "min": 0,
            "max": 100,
            "step": 10,
            "unit": "px"
        },
        {
            "type": "header",
            "content": "Heading Section"
        },
        {
            "type": "text",
            "id": "title",
            "label": "Title",
            "default": "Inspiration"
        },
        {
            "type": "textarea",
            "id": "description",
            "label": "Description"
        },
        {
            "type": "text",
            "id": "button",
            "label": "Button"
        },
        {
            "type": "url",
            "id": "button_link",
            "label": "Button link"
        },
        {
            "type": "header",
            "content": "Custom Color"
        },
        {
            "type": "checkbox",
            "id": "custom_color",
            "label": "Turn on custom color",
            "default": false
        },
        {
            "type": "color",
            "id": "color_heading",
            "label": "Heading Color"
        },
        {
            "type": "color",
            "id": "color_text",
            "label": "Description Color"
        },
        {
            "type": "color",
            "id": "color_btn_text",
            "label": "Link Color"
        }
    ],
    "blocks": [
        {
            "type": "Image",
            "name": "Image",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "Image"
                },{
                  "type": "url",
                  "id": "link_url",
                  "label": "Image link"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Masonry grid",
            "category": "grid",
            "blocks": [
                {
                    "type": "Image"
                },
                {
                    "type": "Image"
                },
                {
                    "type": "Image"
                },
                {
                    "type": "Image"
                },
                {
                    "type": "Image"
                },
                {
                    "type": "Image"
                }
            ]
        }
    ]
}
{% endschema %}
