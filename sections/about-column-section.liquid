<div class="row">
  {% for block in section.blocks %}
    <div class="col-12 col-md-6 mb-5">
      {% if block.settings.heading != blank %}
        <h2>{{ block.settings.heading }}</h2>
      {% endif %}
      {% if block.settings.description != blank %}
        <div class="rich-text-place-print">
          {{ block.settings.description }}
        </div>
      {% endif %}
    </div>
  {% endfor %}
</div>

<style>
  h2 {
    font-weight: 700;
    margin-bottom: 1rem;
    text-align: left !important;
  }
  .rich-text-place-print {
    font-size: 1rem;
    color: #444;
    line-height: 1.5;
    margin-left: 0px !important;
  }
  .row{
    
  }
  #shopify-section-template--20812986253461__about_column_section_b9B3FV {
    margin: auto;
    width: 49%;
  }
   
</style>

{% schema %}
{
  "name": "Two-column Text Section",
  "max_blocks": 2,
  "blocks": [
    {
      "type": "text_colum123",
      "name": "Column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading (H2)",
          "default": "What the guide includes"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Inside the Place Prints with Confidence guide, you’ll find:</p><ul><li>Room-by-room guidance for placing prints throughout your home</li><li>Advice on scale, size, and height (without rigid rules)</li><li>Tips for working with natural light and existing furniture</li><li>Ideas for groupings, pairs, and unexpected placements</li><li>Gentle permission to trust your instincts and experiment</li><li>All drawn from years of photographing real homes and seeing how art transforms a space.</li></ul>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Two-column Guide Text",
      "category": "Text"
    }
  ]
}
{% endschema %}
