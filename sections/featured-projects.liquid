  {% comment %}
    
  
  <script>
    const slides = document.querySelector('.fp-slides');
    const allSlides = document.querySelectorAll('.fp-slide');
    let slideCount = allSlides.length;
    let currentIndex = 0;
    const leftBtn = document.querySelector('.fp-slider-btn.left');
    const rightBtn = document.querySelector('.fp-slider-btn.right');
    
    function updateArrows() {
      leftBtn.style.display = currentIndex === 0 ? 'none' : '';
      rightBtn.style.display = currentIndex === slideCount - 1 ? 'none' : '';
    }
    
    leftBtn.onclick = () => {
      if (currentIndex > 0) {
        currentIndex = (currentIndex - 1 + slideCount) % slideCount;
        slides.style.transform = `translateX(-${currentIndex * 100}%)`;
        updateArrows();
      }
    };
    rightBtn.onclick = () => {
      if (currentIndex < slideCount - 1) {
        currentIndex = (currentIndex + 1) % slideCount;
        slides.style.transform = `translateX(-${currentIndex * 100}%)`;
        updateArrows();
      }
    };
    
    updateArrows();
    
    // Optional: update slideCount on resize if you dynamically hide/show slides
    window.addEventListener('resize', () => {
      slideCount = document.querySelectorAll('.fp-slide').length;
      if (currentIndex >= slideCount) {
        currentIndex = slideCount - 1;
        slides.style.transform = `translateX(-${currentIndex * 100}%)`;
      }
      updateArrows();
    });
  </script>
