<style>


  .container-r {
    width: 100%;
    max-width: 1620px;
    margin: 0 auto;
    box-sizing: border-box;
    overflow-x: auto;
    padding-bottom: 32px;
  }
  .container-r .row {
    display: flex;
    gap: 20px;
    margin-bottom: 20px;
    justify-content: center;
  }
  .container-r .block {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 1.2rem;
    font-weight: bold;
    position: relative;
    box-sizing: border-box;
  }
  /* Scaled Sizes */
  .container-r .block1 {
    width: 100%;
    height: 400px;
    margin: 0 auto 16px;
  }
  .container-r .block img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

.container-r .row{
  display:flex;
  gap:20px;
  padding: 0px 35px;
}
.container-r .row img{
  width:100%;
}
.container-r .row:nth-child(2)>div:nth-child(1){
  width: calc(35.3% - 10px);
}
.container-r .row:nth-child(2)>div:nth-child(2){
  width: calc(64.7% - 10px);
}
.container-r .block1{
  margin-bottom: 20px !important;
  height: auto;
}
.container-r .row:nth-child(3)>div:nth-child(1){
  width: calc(56.74% - 10px);
}
.container-r .row:nth-child(3)>div:nth-child(2){
  width: calc(43.26% - 10px);
}

.container-r .row:nth-child(4)>div:nth-child(1){
  width: calc(42.7% - 10px);
}
.container-r .row:nth-child(4)>div:nth-child(2){
  width: calc(57.3% - 10px);
}
.container-r .row:nth-child(5)>div:nth-child(1){
  width: calc(57.3% - 10px);
}
.container-r .row:nth-child(5)>div:nth-child(2){
  width: calc(42.7% - 10px);
}

 @media (max-width:767px){
   .container-r{
     padding: 0px 15px;
   }
   .container-r .row{
     padding: 0px ;
   }
  .container-r .row>div{
    width: 100% !important;
  }
   .container-r .block1,
   .container-r .block12{
     margin:0 -15px 20px;
     width: calc(100% + 30px);
   }
}
</style>


<div class="container-r">
  <!-- Block 1 -->
  <div class="block block1" style="margin-bottom:16px;">
    {% if section.settings.block1_img %}
      <img src="{{ section.settings.block1_img | image_url }}" alt="Block 1 Image">
    {% endif %}
