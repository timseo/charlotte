{% if settings.breadcrumb_layout == 'top' %}
    {% render 'breadcrumb', breadcrumb_top: true %}
{% endif %}
<div class="page page-productDetail">
    <div class="container">
        {% section 'product-template-bundle-no-gallery' %}
      

        <div class="product-tab-container">
            <div class="product-tab__item">
                {% section 'product-tab-horizontal-bundle-no-gallery' %}
            </div>
            <div class="product-tab__item">
                {% section 'product-add-more-bundle-no-gallery' %}
            </div>
        </div>
      	
      	<div id="looxReviews" data-product-id="{{product.id}}" class="loox-reviews-default">{{ product.metafields.loox.reviews }}</div>
      
        {% section 'product-slider-no-gallery' %}

        {% section 'product-recommendations-bundle' %}

        {% section 'recently-viewed-products-bundle' %}
      

    </div>
</div>
{% if settings.enable_ask_an_expert %}
	{% render 'ask-an-expert-popup' %}
{% endif %}

{% if settings.breadcrumb_layout == 'bottom' %}
    {% render 'breadcrumb' %}
{% endif %}