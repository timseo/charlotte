<div
  class="selector-wrapper selector-wrapper-{{forloop.index}} swatch js product-form__item"
  data-option-index="{{forloop.index}}"
>
  <label class="form-label {% if option.name == 'default' %}label--hidden{% endif %}">
    {{ option.name }}: <span class="label-value-{{ forloop.index }}">{{ option.selected_value }}</span>
  </label>
  {% assign option_index0 = forloop.index0 %}
  {% assign option_index = forloop.index %}
  {% assign values = '' %}
  {% for variant in product.variants %}
    {% assign value = variant.options[option_index0] %}
    {% unless values contains value %}
      {% assign values = values | join: ';' %}
      {% assign values = values | append: ';' | append: value %}
      {% assign values = values | split: ';' %}
      {% assign value_2 = value | remove: ' ' | downcase %}
      <div
        class="swatch-element color {{ value_2 }}{% if variant.available %} available{% else %} soldout{% endif %}"
        data-value="{{ value }}"
      >
        <input
          {% unless variant.available %}
            disabled
          {% endunless %}
          class="single-option-selector single-option-selector-{{ section.id }}"
          type="radio"
          name="SingleOptionSelector-{{ option_index0 }}"
          data-index="option{{ option_index }}"
          value="{{ value | escape }}"
          {% if option.selected_value == value %}
            checked="checked"
          {% endif %}
          id="SingleOptionSelector{{ option_index0 }}-{{ value }}"
          {% if changeImageGroup %}
            data-filter=".filter-{{ value | handle }}"
          {% endif %}
        >
        <label
          data-toggle="tooltip"
          data-placement="top"
          title="{{ value }}"
          for="SingleOptionSelector{{ option_index0 }}-{{ value }}"

          {% comment %}
          {% if variant.image != blank %}
            data-image="{{ variant.image.src | product_img_url: 'compact' | split: '?' | first }}"
            style="background-image: url({{ variant.image.src | product_img_url: 'compact' }})"
          {% else %}
            style="background-color: var(--{{ value_2 }}); background-image: url({{ value_2 | handle | append: '.png' | file_url }})"
          {% endif %}
          {% endcomment %}
          style="background-color: var(--{{ value_2 }}); background-image: url({{ value_2 | handle | append: '.png' | file_url }})"
        >
          {{- value -}}
        </label>
      </div>
    {% endunless %}
  {% endfor %}
</div>
