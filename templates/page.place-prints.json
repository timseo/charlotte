block_order":["slide_x9qUPM","slide_4KLAUa","slide_kwtfV6"],"disabled":true,"name":"Featured Projects Slider","settings":{"title":"FEATURED PROJECTS"}},"custom_page_6GiAK3":{"type":"custom-page","disabled":true,"name":"Page Content with Map","settings":{"display_google_map":true,"google_map_code":""}},"custom_section_PeJFfb":{"type":"custom-section","blocks":{"spacer_9p3XTx":{"type":"spacer","settings":{}},"image_f7aYkx":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/charlotte-lea-printshop-email-collection-image.webp"}},"text_GUHGh3":{"type":"text","settings":{"heading":"Place Prints with Confidence","text":"<h2><strong>room-by-room guide to choosing where art truly belongs<\/strong><\/h2><p>Choosing art is personal — but knowing <em>where<\/em> to place it can feel surprisingly tricky.<\/p><p>This free guide is designed to help you feel confident hanging, styling, and living with art you love — whether you’re starting with a print in hand or a wall that feels unfinished.<\/p>"}}},"block_order":["spacer_9p3XTx","image_f7aYkx","text_GUHGh3"],"name":"CC About Section","settings":{"title":"","custom_class":""}},"form_about_Gcrrkt":{"type":"form-about","name":"About Form","settings":{"title":"Please Do Get In Touch!","description":"I’d love to hear from you – please use the form below to send me any questions or comments or simply email me at cl@charlottelea.com.","button_text":"Submit Form"}},"about_column_section_b9B3FV":{"type":"about-column-section","blocks":{"text_colum123_e4dVAw":{"type":"text_colum123","settings":{"heading":"What the guide includes","description":"<p>Inside the <strong>Place Prints with Confidence<\/strong> guide, you’ll find:<\/p><ul><li>Room-by-room guidance for placing prints throughout your home<\/li><li>Advice on scale, size, and height (without rigid rules)<\/li><li>Tips for working with natural light and existing furniture<\/li><li>Ideas for groupings, pairs, and unexpected placements<\/li><li>Gentle permission to trust your instincts and experiment<\/li><\/ul><p>All drawn from years of photographing real homes and seeing how art transforms a space.<\/p>"}},"text_colum123_aLrwVL":{"type":"text_colum123","settings":{"heading":"Who it’s for","description":"<p>This guide is for you if:<\/p><ul><li>You’ve found a print you love but aren’t quite sure where it should live<\/li><li>You’re decorating slowly and thoughtfully<\/li><li>You care about how your home <em>feels<\/em>, not just how it looks<\/li><li>You want guidance that’s practical, not prescriptive<\/li><\/ul>"}}},"block_order":["text_colum123_e4dVAw","text_colum123_aLrwVL"],"name":"Two-column Guide Section","settings":{}}},"order":["main","advanced_layout_MFjr43","logo_bar_FqnPV7","1cbe8cdb-4da7-4118-82cb-dab47197d857","grid_page_J8J8cJ","featured_projects_pEREJQ","custom_page_6GiAK3","custom_section_PeJFfb","form_about_Gcrrkt","about_column_section_b9B3FV"]}